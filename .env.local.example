# AI Provider Configuration
# Set to "openai" for direct OpenAI, "openrouter" for OpenRouter, or "vercel" for Vercel AI Gateway
AI_PROVIDER=openai

OPENAI_API_KEY=your-openai-api-key

# Optional: Only needed if using Vercel AI Gateway
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
AI_GATEWAY_URL=your-gateway-url

# Optional: Only needed if using OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key

# Nango integration for backend system tool actions
NANGO_SECRET_KEY=your-nango-secret-key